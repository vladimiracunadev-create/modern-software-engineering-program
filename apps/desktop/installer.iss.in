; Plantilla de Inno Setup. scripts/build_apps.py sustituye los marcadores @...@.
[Setup]
AppId={{B7E2C4A1-5D3F-4E8A-9C61-2F0A7D4B8E15}
AppName=Ingeniería de Software Moderna
AppVersion=@VERSION@
AppPublisher=Vladimir Acuña
AppPublisherURL=https://github.com/vladimiracunadev-create/modern-software-engineering-program
DefaultDirName={autopf}\Ingenieria de Software Moderna
DefaultGroupName=Ingeniería de Software Moderna
OutputDir=@OUTDIR@
OutputBaseFilename=@OUTNAME@
SetupIconFile=@ICON@
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
PrivilegesRequiredOverridesAllowed=dialog
ArchitecturesInstallIn64BitMode=x64compatible

[Languages]
Name: "es"; MessagesFile: "compiler:Languages\Spanish.isl"

[Tasks]
Name: "desktopicon"; Description: "Crear un acceso directo en el escritorio"; GroupDescription: "Accesos directos:"

[Files]
Source: "@APPDIR@\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\Ingeniería de Software Moderna"; Filename: "{app}\@EXE@"
Name: "{group}\Desinstalar Ingeniería de Software Moderna"; Filename: "{uninstallexe}"
Name: "{autodesktop}\Ingeniería de Software Moderna"; Filename: "{app}\@EXE@"; Tasks: desktopicon

[Run]
Filename: "{app}\@EXE@"; Description: "Abrir el programa"; Flags: nowait postinstall skipifsilent
